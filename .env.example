# The Laravel API (ends in /api/v1) and the shared key that lets it trust this server's requests
API_URL=http://127.0.0.1:8000/api/v1
BFF_KEY=

# The public site URL: canonical links, sitemaps, robots.txt, share links (required for a production build)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Seals the question in answer links. Generate one: node scripts/generate-ask-link-key.mjs <file>
# Rotate as "k2:…,k1:…" (newest first) so links already shared keep working. Required for a build.
ASK_LINK_KEY=

# Turnstile (reports, contact and shares). Cloudflare's always-pass test key for development:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# PostHog analytics (EU). Leave the key empty to turn analytics fully off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
